//+------------------------------------------------------------------+
//|                                     ConsolidationBreakoutBot.mq5 |
//|                                                Generated by AI   |
//+------------------------------------------------------------------+
#property copyright "Generated by AI"
#property link      ""
#property version   "1.02" // Fresh Version for Cent Accounts

#include <Trade\Trade.mqh>
CTrade trade;

input double InpLotSize = 0.1;           // Lot Size
input int    InpLoopback = 20;           // Loopback Period
input int    InpConsLen = 13;            // Min Consolidation Length
input ulong  InpMagicNumber = 123456;    // Magic Number

bool HasOpenPosition() {
    for(int i = PositionsTotal() - 1; i >= 0; i--) {
        if(PositionGetTicket(i) > 0) {
            if(PositionGetString(POSITION_SYMBOL) == Symbol() && PositionGetInteger(POSITION_MAGIC) == InpMagicNumber) {
                return true;
            }
        }
    }
    return false;
}

// Function to ensure Lot Size is perfectly legal for Cent Accounts
double CheckLotSize(double lot) {
    double min_lot = SymbolInfoDouble(Symbol(), SYMBOL_VOLUME_MIN);
    double max_lot = SymbolInfoDouble(Symbol(), SYMBOL_VOLUME_MAX);
    double step_lot = SymbolInfoDouble(Symbol(), SYMBOL_VOLUME_STEP);
    
    if (lot < min_lot) lot = min_lot;
    if (lot > max_lot) lot = max_lot;
    
    int steps = (int)MathRound((lot - min_lot) / step_lot);
    lot = min_lot + steps * step_lot;
    return lot;
}

int OnInit() {
    trade.SetExpertMagicNumber(InpMagicNumber);
    return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason) {
    ObjectsDeleteAll(0, "ConsBox_");
}

void OnTick() {
    static datetime last_bar = 0;
    datetime current_bar = iTime(Symbol(), Period(), 0);
    if(current_bar == last_bar) return; 
    
    int prd = InpLoopback;
    int conslen = InpConsLen;
    int max_lookback = 1000 + prd; 
    int copied_bars = max_lookback + prd + 10; 
    
    // Check if the Cent Account has downloaded enough history
    if (iBars(Symbol(), Period()) < copied_bars) {
        Print("Waiting for more historical data to load for ", Symbol(), "...");
        return;
    }

    double High[], Low[], Close[];
    datetime Time[];
    ArraySetAsSeries(High, true); ArraySetAsSeries(Low, true); ArraySetAsSeries(Close, true); ArraySetAsSeries(Time, true);
    if (CopyHigh(Symbol(), Period(), 0, copied_bars, High) == -1) return;
    if (CopyLow(Symbol(), Period(), 0, copied_bars, Low) == -1) return;
    if (CopyClose(Symbol(), Period(), 0, copied_bars, Close) == -1) return;
    if (CopyTime(Symbol(), Period(), 0, copied_bars, Time) == -1) return;

    int dir_arr[]; ArrayResize(dir_arr, max_lookback);
    double zz_arr[]; ArrayResize(zz_arr, max_lookback);
    
    int current_dir = 0;
    for(int i = max_lookback - 1; i >= 1; i--) {
        bool is_hb = true;
        for(int j = 1; j < prd; j++) {
            if (High[i+j] > High[i]) { is_hb = false; break; }
        }
        double hb = is_hb ? High[i] : EMPTY_VALUE;

        bool is_lb = true;
        for(int j = 1; j < prd; j++) {
            if (Low[i+j] < Low[i]) { is_lb = false; break; }
        }
        double lb = is_lb ? Low[i] : EMPTY_VALUE;

        int new_dir = current_dir;
        if (hb != EMPTY_VALUE && lb == EMPTY_VALUE) new_dir = 1;
        else if (lb != EMPTY_VALUE && hb == EMPTY_VALUE) new_dir = -1;

        double zz = EMPTY_VALUE;
        if (hb != EMPTY_VALUE && lb != EMPTY_VALUE) {
            zz = (new_dir == 1) ? hb : lb;
        } else {
            if (hb != EMPTY_VALUE) zz = hb;
            else if (lb != EMPTY_VALUE) zz = lb;
        }
        
        dir_arr[i] = new_dir;
        zz_arr[i] = zz;
        current_dir = new_dir;
    }

    int conscnt = 0;
    double condhigh = EMPTY_VALUE;
    double condlow = EMPTY_VALUE;
    double prev_pp = EMPTY_VALUE;
    double pp = EMPTY_VALUE;

    bool breakoutup = false;
    bool breakoutdown = false;
    
    double final_condhigh = EMPTY_VALUE;
    double final_condlow = EMPTY_VALUE;

    for(int i = max_lookback - 1; i >= 1; i--) {
        if (i == max_lookback - 1 || dir_arr[i] != dir_arr[i+1]) { 
            if (zz_arr[i] != EMPTY_VALUE) pp = zz_arr[i];
        } else {
            if (zz_arr[i] != EMPTY_VALUE) {
                if (pp == EMPTY_VALUE) pp = zz_arr[i];
                else {
                    if (dir_arr[i] == 1 && zz_arr[i] > pp) pp = zz_arr[i];
                    if (dir_arr[i] == -1 && zz_arr[i] < pp) pp = zz_arr[i];
                }
            }
        }
        
        breakoutup = false;
        breakoutdown = false;
        bool pp_changed = (pp != prev_pp); 
        
        if (pp_changed) {
            if (conscnt > conslen) {
                if (condhigh != EMPTY_VALUE && pp > condhigh) {
                    breakoutup = true;
                    final_condhigh = condhigh;
                    final_condlow = condlow;
                }
                if (condlow != EMPTY_VALUE && pp < condlow) {
                    breakoutdown = true;
                    final_condhigh = condhigh;
                    final_condlow = condlow;
                }
            }
            if (conscnt > 0 && condhigh != EMPTY_VALUE && condlow != EMPTY_VALUE && pp <= condhigh && pp >= condlow) {
                conscnt = conscnt + 1;
            } else {
                conscnt = 0;
            }
        } else {
            conscnt = conscnt + 1;
        }

        if (conscnt >= conslen) {
            if (conscnt == conslen) {
                double max_h = High[i];
                double min_l = Low[i];
                for(int j=1; j<conslen; j++) {
                    if (High[i+j] > max_h) max_h = High[i+j];
                    if (Low[i+j] < min_l) min_l = Low[i+j];
                }
                condhigh = max_h;
                condlow = min_l;
            } else {
                if (condhigh != EMPTY_VALUE) condhigh = MathMax(condhigh, High[i]);
                if (condlow != EMPTY_VALUE) condlow = MathMin(condlow, Low[i]);
            }
            
            string obj_name = "ConsBox_" + IntegerToString(Time[i + conscnt - 1]);
            if (ObjectFind(0, obj_name) < 0) {
                ObjectCreate(0, obj_name, OBJ_RECTANGLE, 0, Time[i + conscnt - 1], condhigh, Time[i], condlow);
                ObjectSetInteger(0, obj_name, OBJPROP_COLOR, clrDarkBlue);
                ObjectSetInteger(0, obj_name, OBJPROP_BACK, true);
                ObjectSetInteger(0, obj_name, OBJPROP_FILL, true);
            } else {
                ObjectSetInteger(0, obj_name, OBJPROP_TIME, 1, Time[i]);
                ObjectSetDouble(0, obj_name, OBJPROP_PRICE, 0, condhigh);
                ObjectSetDouble(0, obj_name, OBJPROP_PRICE, 1, condlow);
            }
        }
        
        prev_pp = pp;
    }

    if (!HasOpenPosition()) {
        double safe_lot = CheckLotSize(InpLotSize);
        if (breakoutup && final_condlow != EMPTY_VALUE) {
            double sl = NormalizeDouble(final_condlow, _Digits);
            double ask = SymbolInfoDouble(Symbol(), SYMBOL_ASK);
            double risk = ask - sl;
            if (risk > 0) {
                double tp = NormalizeDouble(ask + risk, _Digits);
                if(!trade.Buy(safe_lot, Symbol(), ask, sl, tp, "Consolidation Breakout Up")) {
                    Print("Trade Buy Failed! Error: ", GetLastError());
                }
            }
        }
        else if (breakoutdown && final_condhigh != EMPTY_VALUE) {
            double sl = NormalizeDouble(final_condhigh, _Digits);
            double bid = SymbolInfoDouble(Symbol(), SYMBOL_BID);
            double risk = sl - bid;
            if (risk > 0) {
                double tp = NormalizeDouble(bid - risk, _Digits);
                if(!trade.Sell(safe_lot, Symbol(), bid, sl, tp, "Consolidation Breakout Down")) {
                    Print("Trade Sell Failed! Error: ", GetLastError());
                }
            }
        }
    }
    
    last_bar = current_bar;
}
